  .q-list{ display:grid; gap:10px; }
  .q-item{
    background:#fff; border:1px solid var(--paper-deep); border-radius:10px; padding:14px 16px;
    font-size:.9rem;
  }
  .q-item .q{ font-weight:700; color:var(--line-navy); }
  .q-item .a-hint{ color:var(--ink-soft); font-size:.82rem; margin-top:4px; }

