  .ng-box .ng-label{ color:var(--clay); font-weight:700; font-size:.76rem; margin-bottom:4px; }

  footer{ background:var(--line-navy); color:rgba(246,243,236,.65); text-align:center; padding:20px; font-size:.74rem; }
