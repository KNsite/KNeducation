  h1,h2,h3{ font-family:"Zen Old Mincho", serif; letter-spacing:.02em; }
  a{ color:inherit; }

  header{ background:var(--line-navy); color:var(--paper); padding:16px 20px; }
  .crumb{ max-width:820px; margin:0 auto; font-size:.78rem; color:rgba(246,243,236,.7);}
  .crumb a{ color:var(--gold); text-decoration:none; }
  .h-title{ max-width:820px; margin:6px auto 0; font-size:1.3rem; }

  main{ max-width:820px; margin:0 auto; padding:36px 20px 70px; }

  section{ margin-bottom:44px; }
  .sec-eyebrow{ font-size:.7rem; letter-spacing:.14em; font-weight:700; color:var(--teal); margin-bottom:6px;}
  section h2{ font-size:1.3rem; color:var(--line-navy); margin-bottom:14px; }

  /* ---- 書き方ポイント ---- */
  .point-list{ list-style:none; }
  .point-list li{
    padding:12px 0 12px 30px; position:relative; border-bottom:1px solid var(--paper-deep);
    font-size:.92rem;
  }
  .point-list li::before{
    content:"◆"; position:absolute; left:0; top:12px; color:var(--gold); font-size:.75rem;
  }

  /* ---- テンプレート ---- */
  .pattern-box{
    background:var(--line-navy); color:var(--paper); border-radius:14px;
    padding:22px 24px; margin-bottom:18px;
  }
  .pattern-box .label{ font-size:.68rem; letter-spacing:.1em; color:var(--gold); font-weight:700; margin-bottom:10px;}
  .pattern-box .sentence{
    font-family:"Zen Old Mincho", serif; font-size:1.05rem; line-height:2;
  }
  .pattern-box .blank{
    display:inline-block; border-bottom:2px solid var(--gold); padding:0 6px; color:var(--gold); font-weight:700;
  }

  .blank-explain{ display:grid; gap:10px; margin-bottom:22px; }
  .blank-explain .row{
    display:flex; gap:12px; background:#fff; border:1px solid var(--paper-deep); border-radius:10px;
    padding:12px 14px; font-size:.86rem; align-items:flex-start;
  }
  .blank-explain .tag{
    flex-shrink:0; background:var(--gold); color:var(--line-navy); font-weight:700;
    font-size:.72rem; padding:3px 9px; border-radius:6px; margin-top:2px;
  }
  .blank-explain .body b{ display:block; margin-bottom:2px; }
  .blank-explain .body span{ color:var(--ink-soft); font-size:.84rem; }

  .flow{ display:flex; flex-wrap:wrap; gap:8px; align-items:center; margin-top:6px; }
  .flow .step{
    background:#fff; border:1px solid var(--paper-deep); border-radius:8px;
    padding:8px 14px; font-size:.82rem; font-weight:500;
  }
  .flow .arrow{ color:var(--teal); font-weight:700; }

