<style>
  :root{
    --paper:      #F6F3EC;
    --paper-deep: #EEE8DA;
    --ink:        #1D2430;
    --ink-soft:   #565F6E;
    --line-navy:  #14213D;
    --gold:       #C79A3C;
    --teal:       #2C6E6B;
    --clay:       #B5533F;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  body{
    background:var(--paper); color:var(--ink);
    font-family:"Noto Sans JP", sans-serif; line-height:1.8;
    -webkit-font-smoothing:antialiased;
